generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String   @db.Text
  specifications Json?
  category       String
  applications   String?  @db.Text
  packaging      String?  @db.Text
  status         String   @default("published") // draft, published, archived
  isFeatured     Boolean  @default(false)
  images         Media[]  @relation("ProductImages")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BlogPost {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  content        String   @db.Text
  excerpt        String?  @db.Text
  category       String
  status         String   @default("draft") // draft, published, archived
  featured       Boolean  @default(false)
  featuredImage  String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  eventDate   DateTime
  location    String?
  category    String?
  status      String   @default("published")
  images      Media[]  @relation("EventImages")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  caption   String?
  category  String?
  imageUrl  String
  publicId  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DistributorLead {
  id                   String   @id @default(cuid())
  companyName          String
  contactPerson        String
  email                String
  phone                String
  country              String?
  distributionInterest String?
  message              String?  @db.Text
  status               String   @default("new") // new, contacted, qualified, closed
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FAQ {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text
  category String
  order    Int    @default(0)
}

model Media {
  id            String   @id @default(cuid())
  cloudinaryUrl String
  publicId      String   @unique
  altText       String?
  width         Int?
  height        Int?
  format        String?
  bytes         Int?
  uploadedAt    DateTime @default(now())
  product       Product? @relation("ProductImages", fields: [productId], references: [id], onDelete: SetNull)
  productId     String?
  event         Event?   @relation("EventImages", fields: [eventId], references: [id], onDelete: SetNull)
  eventId       String?
}

model Certificate {
  id          String   @id @default(cuid())
  name        String
  issuer      String
  description String?  @db.Text
  imageUrl    String?
  fileUrl     String?
  createdAt   DateTime @default(now())
}

model Store {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  state     String
  phone     String?
  email     String?
  status    String   @default("published") // draft, published, archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeConfig {
  id              String   @id @default("global")
  
  // Hero Section
  heroTitle       String   @default("Nigeria's Leading Producer of Sanitary Pads & Medical Consumables")
  heroSubtitle    String   @default("Quality, Affordable, and Trusted brands for Hospitals, Health Centres, and Households.")
  heroDescription String?  @db.Text
  heroImage       String?  // Main hero image URL
  heroImages      Json?    // DEPRECATED: Mapping compatibility workaround
  
  // Stats Section
  stats           Json?    // Array of { label, value, icon, desc, color }
  
  // Features Section
  features        Json?    // Array of { title, description, icon }

  // About Section
  aboutTitle      String   @default("Manufacturing Excellence")
  aboutSubtitle   String   @default("Sustainable Production")
  aboutDescription String? @default("Our ultra-modern facility in Niger State utilizes automated systems to ensure every product meets pharmaceutical-grade hygiene standards.") @db.Text
  aboutImage      String?  @default("/hero-bg.jpg")
  aboutEstablishedText String @default("Established Since 1999")
  aboutVision      String   @default("To be the Market Leader in the production and Distribution of Quality and Affordable Sanitary pads and proximate Medical Devices in Nigeria and the West Coast.")
  aboutMission     String   @default("To be the Market Leader in the production and Distribution of Quality and Affordable Sanitary pads and proximate Medical Devices in Nigeria and the West Coast.")
  aboutQuote       String   @default("Often being recommended as part of the Hospital child delivery list.")
  aboutHeritageStats Json?    // Array of { label, value, icon }
  aboutHeritageImages Json?   // Array of strings (image URLs)
  aboutFloatingImages Json?   // Array of { url, top, left, size, mobileSize, delay }
  aboutFeatureImage   String?  // LadySept highlighted product image
  aboutStatBadgeValue String @default("25+")
  aboutStatBadgeLabel String @default("Years of Excellence")
  aboutLadySeptFeatures Json? // Array of strings
  aboutFutureText   String?  @db.Text
  aboutSupportTitle String   @default("We ensure that no one loses confidence because of their gender.")
  aboutSupportDescription String? @db.Text
  
  // Social & Contact
  socialLinks     Json?    // { facebook, twitter, instagram, linkedin, whatsapp }
  contactInfo     Json?    // { email, phone, address, workingHours }
  
  updatedAt       DateTime @updatedAt
}
